{
  "name": "@s360/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --watch --env-file-if-exists=../../.env dist/main.js",
    "start": "node dist/main.js",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "tenant:create": "node --env-file-if-exists=../../.env dist/scripts/create-tenant.js",
    "seed:demo": "node --env-file-if-exists=../../.env dist/scripts/seed-demo.js",
    "load-test": "node --env-file-if-exists=../../.env dist/scripts/load-test.js"
  },
  "dependencies": {
    "@nestjs/common": "12.6.2",
    "@nestjs/core": "12.6.2",
    "@nestjs/platform-express": "12.6.2",
    "@nestjs/throttler": "6.8.0",
    "@s360/contracts": "workspace:*",
    "@s360/db": "workspace:*",
    "argon2": "0.45.2",
    "cookie-parser": "1.4.7",
    "drizzle-orm": "0.45.4",
    "exceljs": "4.4.0",
    "helmet": "8.3.0",
    "jose": "6.2.18",
    "otpauth": "9.6.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.6.2",
    "@swc/core": "1.16.22",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "26.6.10",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.2",
    "typescript": "7.0.2",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.2"
  }
}
