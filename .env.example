# Supply360 local configuration. Copy to .env and replace every value marked CHANGE-ME.
# Never commit .env. In production these come from the secret manager.

NODE_ENV=development
PORT=4000

# API connects as a login role that is a member of s360_app (row-level security applies to it).
DATABASE_URL=postgres://s360_api:CHANGE-ME@localhost:5432/supply360
# Owner role: migrations and the tenant provisioning CLI only.
DATABASE_ADMIN_URL=postgres://postgres:CHANGE-ME@localhost:5432/supply360

# 32+ random characters:  openssl rand -hex 32
SESSION_SECRET=CHANGE-ME
# 32 random bytes, base64:  openssl rand -base64 32
FIELD_ENCRYPTION_KEY=CHANGE-ME

WEB_ORIGIN=http://localhost:3000
SESSION_TTL_HOURS=12
LOGIN_RATE_LIMIT=10
# Requests per minute per client address on every other route.
API_RATE_LIMIT=300
COOKIE_SECURE=false
# Public URL SampTrek and respondents use for webhooks and redirects (defaults to WEB_ORIGIN).
# PUBLIC_BASE_URL=https://supply360.example.com
# Poll SampTrek for changed projects every N seconds (0 = off).
SOURCE_POLL_SECONDS=300
# Invitation scheduler pass every N seconds (0 = off). Participation link key defaults to one derived from SESSION_SECRET.
DISPATCH_TICK_SECONDS=30
# Reconcile live projects against SampTrek sessions every N minutes (0 = off)
RECONCILE_MINUTES=30
# PARTICIPATION_TOKEN_SECRET=

# Web app: where Next.js forwards /api/v1 (server side only).
S360_API_URL=http://localhost:4000

# Only for `pnpm db:seed:demo` (local DEMO tenant) and `tenant:create`.
S360_DEMO_PASSWORD=CHANGE-ME
S360_ADMIN_PASSWORD=CHANGE-ME

# Docker Compose only
POSTGRES_PASSWORD=CHANGE-ME
S360_API_DB_PASSWORD=CHANGE-ME

# Only while rotating the field key (docs/runbooks/key-rotation.md): the old key, until `rotate:reseal` has run.
# FIELD_ENCRYPTION_KEY_PREVIOUS=

# Observability
# Bearer token for GET /api/v1/metrics (Prometheus). Unset = the endpoint answers 404. At least 32 characters.
# METRICS_TOKEN=
# Log format: json (default in production) or text.
# LOG_FORMAT=json
# Version string reported by /health (set by the release image).
# S360_VERSION=

# Production start-up refuses to run unless COOKIE_SECURE=true, WEB_ORIGIN and PUBLIC_BASE_URL are https,
# PARTICIPATION_TOKEN_SECRET is set, no value is CHANGE-ME, DATABASE_URL is not the postgres or admin user, and LOGIN_RATE_LIMIT is 30 or less.
